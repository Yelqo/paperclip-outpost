{
  "name": "@yelqo/paperclip-outpost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "paperclipPlugin": {"manifest": "./dist/manifest.js", "worker": "./dist/worker.js"},
  "scripts": {
    "prepare:host": "node scripts/prepare-host.mjs",
    "build": "tsc --noEmit && node scripts/build-plugin.mjs && go build -o bin/outpost ./cmd/outpost",
    "check": "tsc --noEmit && go vet ./...",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:workflow": "node --test tests/workflow.test.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "link:.cache/paperclip/packages/plugins/sdk",
    "effect": "3.19.19"
  },
  "devDependencies": {"@types/node": "24.10.1", "typescript": "5.9.3", "ws": "8.18.3", "esbuild":"0.25.12"},
  "engines": {"node": ">=24.19.0"},
  "packageManager": "pnpm@9.15.4"
}
