+
+describe("WebSocket worker execution bounds", () => {
+  it("retains admission permits after RPC timeout until the worker replies", async () => {
+    const connect = await fixture();
+    const first = Array.from({ length: 64 }, () => rejected(connect("webSocketOpen"), 7000));
+    expect(await Promise.all(first)).toEqual(Array(64).fill(503));
+    expect((await stats()).pending).toBe(64);
+    expect(await Promise.all(Array.from({ length: 64 }, () => rejected(connect("normal"))))).toEqual(Array(64).fill(503));
+    expect((await stats()).counts.webSocketOpen).toBe(64);
+    await handle.call("getData", { key: "release" });
+    await eventually(async () => (await stats()).pending === 0);
+    await opened(connect("normal"));
+  }, 15000);
+
+  it("retains permits for timed-out message handlers until worker exit", async () => {
+    const connect = await fixture();
+    const clients = Array.from({ length: 64 }, () => connect("webSocketMessage"));
+    await Promise.all(clients.map(opened));
+    const closed = clients.map(ws => new Promise<number>(resolve => ws.once("close", resolve)));
+    for (const ws of clients) ws.send("stall");
+    expect(await Promise.all(closed)).toEqual(Array(64).fill(1011));
+    expect((await stats()).pending).toBe(64);
+    expect(await rejected(connect("normal"))).toBe(503);
+    await handle.restart();
+    await opened(connect("normal"));
+  }, 15000);
+
+  it("keeps stalled cleanup charged after its shorter RPC timeout", async () => {
+    const connect = await fixture();
+    const clients = Array.from({ length: 64 }, () => connect("webSocketClose"));
+    await Promise.all(clients.map(opened));
+    const closed = clients.map(ws => new Promise<void>(resolve => ws.once("close", () => resolve())));
+    for (const ws of clients) ws.close();
+    await Promise.all(closed);
+    await eventually(async () => (await stats()).pending === 64);
+    await delay(1100);
+    expect(await rejected(connect("normal"))).toBe(503);
+    await handle.call("getData", { key: "release" });
+    await opened(connect("normal"));
+  }, 10000);
+});
