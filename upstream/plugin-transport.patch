diff --git a/server/src/services/pi-approval-consumption.ts b/server/src/services/pi-approval-consumption.ts
new file mode 100644
index 000000000..d3836f10e
--- /dev/null
+++ b/server/src/services/pi-approval-consumption.ts
@@ -0,0 +1,48 @@
+import { and, eq } from "drizzle-orm";
+import { heartbeatRuns, issues, issueThreadInteractions, type Db } from "@paperclipai/db";
+import type { RequestConfirmationResult } from "@paperclipai/shared";
+import { conflict, forbidden } from "../errors.js";
+
+/** A human decision is single-use even if the execution host restores a snapshot.
+ * A lost response is a consumed grant, including for the claiming run itself. */
+export async function consumePiApproval(db: Db, input: {
+  companyId: string; issueId: string; interactionId: string; key: string;
+  agentId: string; runId: string;
+}) {
+  return db.transaction(async tx => {
+    const issue = await tx.select().from(issues).where(and(
+      eq(issues.id, input.issueId), eq(issues.companyId, input.companyId),
+    )).for("update").then(rows => rows[0]);
+    if (!issue || issue.assigneeAgentId !== input.agentId || issue.assigneeUserId || ["done", "cancelled"].includes(issue.status)) {
+      throw forbidden("Approval task is closed or reassigned");
+    }
+    const run = await tx.select().from(heartbeatRuns).where(and(
+      eq(heartbeatRuns.id, input.runId), eq(heartbeatRuns.companyId, input.companyId),
+      eq(heartbeatRuns.agentId, input.agentId), eq(heartbeatRuns.status, "running"),
+    )).then(rows => rows[0]);
+    if (!run || run.contextSnapshot?.issueId !== input.issueId || run.resultJson?.executionCancellation) {
+      throw forbidden("Approval consumption requires the active assigned task run");
+    }
+    const interaction = await tx.select().from(issueThreadInteractions).where(and(
+      eq(issueThreadInteractions.id, input.interactionId), eq(issueThreadInteractions.issueId, input.issueId),
+      eq(issueThreadInteractions.companyId, input.companyId),
+    )).for("update").then(rows => rows[0]);
+    const payload = interaction?.payload as { target?: { type?: string; key?: string; revisionId?: string } } | undefined;
+    const result = interaction?.result as RequestConfirmationResult | null | undefined;
+    if (!interaction || interaction.kind !== "request_confirmation" || interaction.status !== "accepted" ||
+        interaction.createdByAgentId !== input.agentId || interaction.effectiveResolverPolicy !== "human_only" ||
+        interaction.requestedResolverPolicy !== "human_only" || interaction.continuationPolicy !== "wake_assignee" ||
+        !interaction.resolvedByUserId || interaction.resolvedByAgentId || !interaction.resolvedAt ||
+        interaction.idempotencyKey !== `pi-approval:${input.key}` || payload?.target?.type !== "custom" ||
+        payload.target.key !== "pi-approval" || payload.target.revisionId !== input.key ||
+        result?.version !== 1 || result.outcome !== "accepted") {
+      throw conflict("An exact authenticated human Pi decision is required");
+    }
+    if (result.executionConsumption) return { consumed: false };
+    const consumption = { runId: input.runId, consumedAt: new Date().toISOString() };
+    await tx.update(issueThreadInteractions).set({
+      result: { ...result, executionConsumption: consumption }, updatedAt: new Date(),
+    }).where(eq(issueThreadInteractions.id, interaction.id));
+    return { consumed: true, ...consumption };
+  });
+}
