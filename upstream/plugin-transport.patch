@@ -0,0 +1,139 @@
+import { execFileSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { randomUUID } from "node:crypto";
+import type { Server } from "node:http";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { WebSocketServer, WebSocket } from "ws";
+import type { Db } from "@paperclipai/db";
+import { PLUGIN_WEBSOCKET_SDK_VERSION, type PluginWebSocketReply } from "@paperclipai/plugin-sdk";
+import type { HostToWorkerMethods } from "@paperclipai/plugin-sdk";
+import { pluginRegistryService } from "../services/plugin-registry.js";
+import type { PluginWorkerManager } from "../services/plugin-worker-manager.js";
+import { readBuildCommit } from "../build-commit.js";
+
+/** Core owns every socket. Plugins see bounded, serialized RPC events only. */
+export function setupPluginWebSocketServer(server: Server, db: Db, workers: PluginWorkerManager) {
+  const registry = pluginRegistryService(db);
+  const wss = new WebSocketServer({ noServer: true, maxPayload: 16 * 1024, perMessageDeflate: false });
+  let commit = readBuildCommit() ?? "";
+  try { commit = execFileSync("git", ["rev-parse", "HEAD"], {
+    cwd: fileURLToPath(new URL("../../../", import.meta.url)), encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: 1000,
+  }).trim(); } catch { /* Packaged hosts must carry the build commit stamp. */ }
+  let shared = "";
+  try {
+    const entry = createRequire(import.meta.url).resolve("@paperclipai/shared");
+    shared = JSON.parse(readFileSync(new URL("../package.json", pathToFileURL(entry)), "utf8")).version;
+  } catch { /* Missing package metadata must reject compatibility before work. */ }
+  const host = { commit, sdk: PLUGIN_WEBSOCKET_SDK_VERSION, shared, transport: 9 };
+  let admitted = 0, opening = 0, stopping = false;
+  const pending = new Set<import("node:stream").Duplex>();
+  server.on("upgrade", (req, socket, head) => {
+    const request = req as typeof req & { paperclipWebSocketHandled?: boolean };
+    if (request.paperclipWebSocketHandled) return;
+    let url: URL;
+    try { url = new URL(req.url ?? "", "http://localhost"); } catch { return; }
+    const match = url.pathname.match(/^\/api\/plugins\/([a-z0-9._-]+)\/ws\/([a-z0-9._-]+)$/);
+    if (!match) return;
+    request.paperclipWebSocketHandled = true;
+    socket.on("error", () => {});
+    pending.add(socket);
+    const deadline = setTimeout(() => socket.destroy(), 6000);
+    socket.once("close", () => { pending.delete(socket); clearTimeout(deadline); });
+    const reject = (status: number) => {
+      if (!socket.destroyed) socket.end(`HTTP/1.1 ${status} Rejected\r\nConnection: close\r\nContent-Length: 0\r\n\r\n`, () => socket.destroy());
+    };
+    const companyId = url.searchParams.get("companyId") ?? "";
+    if (req.headers.origin || !/^[0-9a-f-]{36}$/i.test(companyId) ||
+      [...url.searchParams.keys()].some(key => key !== "companyId" && key !== "outpostId") ||
+      url.search.length > 256) { reject(400); return; }
+    if (stopping || admitted >= 64 || opening >= 64) { reject(503); return; }
+    admitted++;
+    // Admission work keeps its permit even after its peer socket closes.
+    opening++;
+    let released = false, disconnected = false, admissionSettled = false, inFlight = 0;
+    const release = () => {
+      if (!released && disconnected && admissionSettled && inFlight === 0) {
+        released = true; admitted--;
+      }
+    };
+    let cleanup = () => {};
+    socket.once("close", () => { disconnected = true; cleanup(); release(); });
+    void (async () => {
+      const plugin = await registry.getByKey(match[1]!);
+      if (socket.destroyed || stopping) { release(); return; }
+      const worker = plugin ? workers.getWorker(plugin.id) : undefined;
+      if (!plugin || plugin.status !== "ready" || !worker || !workers.isRunning(plugin.id)) { reject(503); return; }
+      if (!plugin.manifestJson.capabilities.includes("transport.websockets.register") ||
+        !plugin.manifestJson.webSocketRoutes?.some(route => route.routeKey === match[2])) { reject(404); return; }
+      const call = <M extends "webSocketOpen" | "webSocketMessage" | "webSocketClose">(
+        method: M, params: HostToWorkerMethods[M][0], timeout: number,
+      ): Promise<HostToWorkerMethods[M][1]> => {
+        inFlight++;
+        const { result, completed } = worker.callWithCompletion(method, params, timeout);
+        void completed.then(() => { inFlight--; release(); });
+        return result;
+      };
+      const workerPid = worker.diagnostics().pid;
+      const connectionId = randomUUID();
+      const input = { connectionId, companyId, routeKey: match[2]!, query: Object.fromEntries(url.searchParams), host,
+        headers: { authorization: req.headers.authorization, versions: typeof req.headers["x-outpost-versions"] === "string" ? req.headers["x-outpost-versions"] : undefined } };
+      const event = { connectionId, companyId, routeKey: input.routeKey, principalId: "" };
+      let closed = false;
+      cleanup = () => {
+        if (closed) return;
+        closed = true;
+        void call("webSocketClose", event, 1000).catch(() => {});
+      };
+      const opened = await call("webSocketOpen", input, 5000);
+      event.principalId = opened.principalId ?? "";
+      if (opened.status !== 101 || !opened.principalId || socket.destroyed) {
+        cleanup(); reject([401,403,409,426,503].includes(opened.status) ? opened.status : 403); return;
+      }
+      wss.handleUpgrade(req, socket, head, ws => {
+        pending.delete(socket);
+        clearTimeout(deadline);
+        const send = (reply: PluginWebSocketReply) => {
+          const messages = reply.messages ?? [];
+          if (!Array.isArray(messages) || messages.length > 4 || messages.some(message => typeof message !== "string" || Buffer.byteLength(message) > 64 * 1024)) {
+            ws.close(1011, "invalid plugin reply"); return;
+          }
+          for (const message of messages) {
+            if (ws.readyState !== WebSocket.OPEN) return;
+            if (ws.bufferedAmount + Buffer.byteLength(message) > 64 * 1024) { ws.close(1013, "transport capacity"); return; }
+            ws.send(message);
+          }
+          if (reply.close) ws.close([1008,1011,1013].includes(reply.closeCode ?? 1008) ? reply.closeCode ?? 1008 : 1011, "transport closed");
+        };
+        let queued = 0, chain = Promise.resolve(), alive = true;
+        const heartbeat = setInterval(() => {
+          if (!alive || !workers.isRunning(plugin.id) || workers.getWorker(plugin.id) !== worker || worker.diagnostics().pid !== workerPid) { ws.terminate(); return; }
+          alive = false; ws.ping();
+        }, 10000);
+        heartbeat.unref();
+        ws.on("pong", () => { alive = true; });
+        ws.on("message", (data, binary) => {
+          if (closed || ws.readyState !== WebSocket.OPEN) return;
+          if (binary || ++queued > 16) { ws.close(1013, "transport capacity"); return; }
+          chain = chain.then(async () => {
+            if (!closed && ws.readyState === WebSocket.OPEN) send(await call("webSocketMessage", {...event, data:data.toString()}, 5000));
+          }).catch(() => { ws.close(1011, "plugin unavailable"); }).finally(() => { queued--; });
+        });
+        ws.on("close", () => { clearInterval(heartbeat); cleanup(); });
+        ws.on("error", () => { ws.terminate(); });
+        send(opened);
+      });
+    })().catch(() => { cleanup(); reject(503); }).finally(() => {
+      opening--; admissionSettled = true; release();
+    });
+  });
+  const stop = () => {
+    if (stopping) return;
+    stopping = true;
+    for (const socket of pending) socket.destroy();
+    for (const ws of wss.clients) ws.terminate();
+    wss.close();
+  };
+  server.once("close", stop);
+  return { stop };
+}
