new file mode 100644
index 000000000..ad3c7a5ca
--- /dev/null
+++ b/server/src/services/plugin-run-cancellation.ts
@@ -0,0 +1,55 @@
+import type { Db } from "@paperclipai/db";
+import { environmentLeases, environments } from "@paperclipai/db";
+import { and, desc, eq } from "drizzle-orm";
+import type { PluginEnvironmentCancelRunResult } from "@paperclipai/plugin-sdk";
+import type { PluginWorkerManager } from "./plugin-worker-manager.js";
+import { parseEnvironmentDriverConfig } from "./environment-config.js";
+
+/** Use the original company's lease and provider snapshot, never an agent's
+ * current target. A missing worker or receipt cannot establish termination. */
+export async function pluginRunCancellation(input: {
+  db: Db; workerManager?: PluginWorkerManager;
+  companyId: string; runId: string; queryOnly: boolean;
+}): Promise<PluginEnvironmentCancelRunResult | null> {
+  const manager = input.workerManager;
+  const [row] = await input.db.select({ lease: environmentLeases, environment: environments })
+    .from(environmentLeases).innerJoin(environments, eq(environments.id, environmentLeases.environmentId))
+    .where(and(eq(environmentLeases.companyId, input.companyId), eq(environmentLeases.heartbeatRunId, input.runId)))
+    .orderBy(desc(environmentLeases.createdAt)).limit(1);
+  if (!row || !["plugin", "sandbox"].includes(row.environment.driver)) return null;
+  const metadata = row.lease.metadata ?? {};
+  const pluginId = typeof metadata.pluginId === "string" ? metadata.pluginId : null;
+  const provider = metadata.providerMetadata as Record<string, unknown> | undefined;
+  const snapshot = metadata.cancellationConfig ?? provider?.cancellationConfig;
+  if (!pluginId || !manager?.isRunning(pluginId) || !manager.getWorker(pluginId)?.supportedMethods.includes("environmentCancelRun")) {
+    if (!snapshot) return null;
+    if (input.queryOnly) return { state: "requested" };
+    throw new Error("Cancellation worker is unavailable; termination remains unconfirmed");
+  }
+  const parsed = row.environment.driver === "plugin"
+    ? parseEnvironmentDriverConfig({ driver: "plugin", config: row.environment.config }) : null;
+  const config = snapshot
+    ?? (parsed?.driver === "plugin" ? parsed.config.driverConfig : null);
+  if (!config || typeof config !== "object") throw new Error("Original cancellation config is unavailable");
+  return manager!.call(pluginId, "environmentCancelRun", {
+    driverKey: typeof metadata.provider === "string" ? metadata.provider
+      : typeof metadata.driverKey === "string" ? metadata.driverKey : "",
+    companyId: input.companyId, environmentId: row.environment.id,
+    config: config as Record<string, unknown>,
+    runId: input.runId, queryOnly: input.queryOnly,
+  }).catch(error => {
+    // An original provider snapshot identifies cancellation support even if
+    // the worker disappears during this read. Persist operator intent first.
+    if (input.queryOnly && snapshot) return { state: "requested" as const };
+    throw error;
+  });
+}
+
+/** Natural signal termination is failure even when it has no numeric exit code. */
+export function pluginRunOutcomeStatus(outcome: Extract<PluginEnvironmentCancelRunResult, { state: "confirmed" }>["outcome"]):
+  "cancelled" | "timed_out" | "failed" | "succeeded" {
+  if (outcome.cancelled) return "cancelled";
+  if (outcome.timedOut) return "timed_out";
+  if (outcome.interrupted || outcome.error || outcome.signal || (outcome.exitCode ?? 0) !== 0) return "failed";
+  return "succeeded";
+}
