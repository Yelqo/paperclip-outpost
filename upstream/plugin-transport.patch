--- /dev/null
+++ b/server/src/__tests__/fixtures/plugin-worker-websocket-stalled.cjs
@@ -0,0 +1,31 @@
+const readline = require("node:readline");
+const connections = new Map();
+const pending = [];
+const counts = { webSocketOpen: 0, webSocketMessage: 0, webSocketClose: 0 };
+let released = false;
+const send = (id, result) => process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", id, result })}\n`);
+
+readline.createInterface({ input: process.stdin }).on("line", line => {
+  const { id, method, params } = JSON.parse(line);
+  if (method === "initialize") {
+    send(id, { ok: true, supportedMethods: [...Object.keys(counts), "getData"] });
+  } else if (method === "getData") {
+    if (params.key === "release") {
+      released = true;
+      for (const reply of pending.splice(0)) reply();
+    }
+    send(id, { counts, pending: pending.length });
+  } else if (method === "shutdown") {
+    send(id, {});
+    setImmediate(() => process.exit(0));
+  } else if (Object.hasOwn(counts, method)) {
+    counts[method]++;
+    if (method === "webSocketOpen") connections.set(params.connectionId, params.query.outpostId);
+    const stall = connections.get(params.connectionId) === method;
+    const result = method === "webSocketOpen" ? { status: 101, principalId: "fixture" } : {};
+    if (method === "webSocketClose") connections.delete(params.connectionId);
+    const reply = () => send(id, result);
+    if (stall && !released) pending.push(reply);
+    else reply();
+  }
+});
