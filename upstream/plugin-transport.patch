@@ -0,0 +1,115 @@
+import { createServer, type Server } from "node:http";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { setTimeout as delay } from "node:timers/promises";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import WebSocket from "ws";
+import type { Db } from "@paperclipai/db";
+import type { PaperclipPluginManifestV1 } from "@paperclipai/shared";
+import { createPluginWorkerHandle, type PluginWorkerHandle, type PluginWorkerManager } from "../services/plugin-worker-manager.js";
+import { setupPluginWebSocketServer } from "../realtime/plugin-ws.js";
+
+vi.mock("../services/plugin-registry.js", () => ({
+  pluginRegistryService: () => ({ getByKey: async () => ({
+    id: "test.plugin", status: "ready", manifestJson: {
+      capabilities: ["transport.websockets.register"], webSocketRoutes: [{ routeKey: "transport" }],
+    },
+  }) }),
+}));
+
+const manifest: PaperclipPluginManifestV1 = {
+  id: "test.plugin", apiVersion: 1, version: "1.0.0", displayName: "Test plugin",
+  description: "Test plugin", author: "Paperclip", categories: ["automation"], capabilities: [],
+  entrypoints: { worker: "dist/worker.js" },
+};
+let handle: PluginWorkerHandle;
+let server: Server;
+let route: ReturnType<typeof setupPluginWebSocketServer>;
+const sockets: WebSocket[] = [];
+
+async function fixture() {
+  handle = createPluginWorkerHandle("test.plugin", {
+    entrypointPath: path.join(path.dirname(fileURLToPath(import.meta.url)), "fixtures/plugin-worker-websocket-stalled.cjs"),
+    manifest, config: {}, instanceInfo: { instanceId: "test", hostVersion: "1.0.0" }, apiVersion: 1, hostHandlers: {},
+  });
+  await handle.start();
+  server = createServer();
+  route = setupPluginWebSocketServer(server, {} as Db, {
+    getWorker: () => handle, isRunning: () => handle.status === "running",
+  } as unknown as PluginWorkerManager);
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const port = (server.address() as { port: number }).port;
+  return (stall: string) => {
+    const ws = new WebSocket(`ws://127.0.0.1:${port}/api/plugins/test.plugin/ws/transport?companyId=00000000-0000-0000-0000-000000000000&outpostId=${stall}`);
+    ws.on("error", () => {});
+    sockets.push(ws);
+    return ws;
+  };
+}
+const stats = () => handle.call("getData", { key: "status" }) as Promise<{ counts: Record<string, number>; pending: number }>;
+async function eventually(check: () => Promise<boolean>) {
+  const end = Date.now() + 2000;
+  while (Date.now() < end) {
+    if (await check()) return;
+    await delay(10);
+  }
+  throw new Error("Transport permits were not recovered");
+}
+function opened(ws: WebSocket) {
+  return new Promise<void>((resolve, reject) => { ws.once("open", resolve); ws.once("error", reject); });
+}
+function rejected(ws: WebSocket, timeout = 1000) {
+  return new Promise<number>((resolve, reject) => {
+    const timer = setTimeout(() => { ws.terminate(); reject(new Error("Admission was forwarded instead of rejected immediately")); }, timeout);
+    ws.once("unexpected-response", (_req, res) => { clearTimeout(timer); res.resume(); ws.terminate(); resolve(res.statusCode!); });
+    ws.once("open", () => { clearTimeout(timer); reject(new Error("Admission exceeded the worker bound")); });
+  });
+}
+
+afterEach(async () => {
+  for (const ws of sockets.splice(0)) ws.terminate();
+  route?.stop();
+  await handle?.stop();
+  if (server?.listening) await new Promise<void>(resolve => server.close(() => resolve()));
+});
+
+describe("WebSocket worker execution bounds", () => {
+  it("retains admission permits after RPC timeout until the worker replies", async () => {
+    const connect = await fixture();
+    const first = Array.from({ length: 64 }, () => rejected(connect("webSocketOpen"), 7000));
+    expect(await Promise.all(first)).toEqual(Array(64).fill(503));
+    expect((await stats()).pending).toBe(64);
+    expect(await Promise.all(Array.from({ length: 64 }, () => rejected(connect("normal"))))).toEqual(Array(64).fill(503));
+    expect((await stats()).counts.webSocketOpen).toBe(64);
+    await handle.call("getData", { key: "release" });
+    await eventually(async () => (await stats()).pending === 0);
+    await opened(connect("normal"));
+  }, 15000);
+
+  it("retains permits for timed-out message handlers until worker exit", async () => {
+    const connect = await fixture();
+    const clients = Array.from({ length: 64 }, () => connect("webSocketMessage"));
+    await Promise.all(clients.map(opened));
+    const closed = clients.map(ws => new Promise<number>(resolve => ws.once("close", resolve)));
+    for (const ws of clients) ws.send("stall");
+    expect(await Promise.all(closed)).toEqual(Array(64).fill(1011));
+    expect((await stats()).pending).toBe(64);
+    expect(await rejected(connect("normal"))).toBe(503);
+    await handle.restart();
+    await opened(connect("normal"));
+  }, 15000);
+
+  it("keeps stalled cleanup charged after its shorter RPC timeout", async () => {
+    const connect = await fixture();
+    const clients = Array.from({ length: 64 }, () => connect("webSocketClose"));
+    await Promise.all(clients.map(opened));
+    const closed = clients.map(ws => new Promise<void>(resolve => ws.once("close", () => resolve())));
+    for (const ws of clients) ws.close();
+    await Promise.all(closed);
+    await eventually(async () => (await stats()).pending === 64);
+    await delay(1100);
+    expect(await rejected(connect("normal"))).toBe(503);
+    await handle.call("getData", { key: "release" });
+    await opened(connect("normal"));
+  }, 10000);
+});
